#include <iostream>
#include <iomanip>
#include <string>

using namespace std;

const int MAX_ORDERS = 50;

// Function to display all orders
void displayOrders(string orderIDs[], string customerNames[],
                   int magwinyas[], float totalCosts[], int count)
{
    if (count == 0)
    {
        cout << "\nNo orders available.\n";
        return;
    }

    cout << "\n==================== ALL ORDERS ====================\n";
    cout << left
         << setw(12) << "Order ID"
         << setw(18) << "Customer"
         << setw(18) << "Magwinyas"
         << setw(15) << "Total Cost" << endl;

    cout << "-------------------------------------------------------\n";

    for (int i = 0; i < count; i++)
    {
        cout << left
             << setw(12) << orderIDs[i]
             << setw(18) << customerNames[i]
             << setw(18) << magwinyas[i]
             << "R" << fixed << setprecision(2)
             << totalCosts[i] << endl;
    }
}

// Function to add a new order
void addOrder(string orderIDs[], string customerNames[],
              int magwinyas[], float totalCosts[], int &count)
{
    if (count >= MAX_ORDERS)
    {
        cout << "\nError: Maximum of 50 orders has been reached.\n";
        return;
    }

    string customerName;
    int numberOfMagwinyas;
    float totalCost;

    // Generate order ID
    if (count == 0)
    {
        orderIDs[count] = "101";
    }
    else
    {
        int previousID = stoi(orderIDs[count - 1]);
        orderIDs[count] = to_string(previousID + 1);
    }

    cout << "\n========== ADD NEW ORDER ==========\n";

    cout << "Enter customer name: ";
    cin.ignore();
    getline(cin, customerName);

    cout << "Enter number of Magwinyas: ";
    cin >> numberOfMagwinyas;

    cout << "Enter total cost: R";
    cin >> totalCost;

    customerNames[count] = customerName;
    magwinyas[count] = numberOfMagwinyas;
    totalCosts[count] = totalCost;

    cout << "\nOrder successfully added!\n";
    cout << "Order ID: " << orderIDs[count] << endl;

    count++;
}

// Function to find an order by Order ID
void findOrder(string orderIDs[], string customerNames[],
               int magwinyas[], float totalCosts[], int count)
{
    string searchID;

    cout << "\nEnter Order ID to search: ";
    cin >> searchID;

    bool found = false;

    for (int i = 0; i < count; i++)
    {
        if (orderIDs[i] == searchID)
        {
            cout << "\n========== ORDER FOUND ==========\n";
            cout << "Order ID:       " << orderIDs[i] << endl;
            cout << "Customer Name:  " << customerNames[i] << endl;
            cout << "Magwinyas:      " << magwinyas[i] << endl;
            cout << "Total Cost:     R"
                 << fixed << setprecision(2)
                 << totalCosts[i] << endl;

            found = true;
            break;
        }
    }

    if (!found)
    {
        cout << "\nOrder ID " << searchID << " was not found.\n";
    }
}

// Function to calculate total revenue
void calculateRevenue(float totalCosts[], int count)
{
    float totalRevenue = 0;

    for (int i = 0; i < count; i++)
    {
        totalRevenue += totalCosts[i];
    }

    cout << "\n========== TOTAL REVENUE ==========\n";
    cout << "Total revenue: R"
         << fixed << setprecision(2)
         << totalRevenue << endl;
}

